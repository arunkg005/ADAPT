<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/adapt_background"
    android:orientation="vertical"
    android:padding="@dimen/page_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Patient Roster"
            android:textColor="@color/adapt_on_surface"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/add_patient_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_button"
            android:contentDescription="Add Patient"
            android:padding="12dp"
            android:src="@drawable/ic_add"
            app:tint="@color/adapt_primary" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Select a patient profile to review their daily tasks and progress."
        android:textColor="@color/adapt_on_surface_variant"
        android:textSize="16sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/patient_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="88dp" />
</LinearLayout>
