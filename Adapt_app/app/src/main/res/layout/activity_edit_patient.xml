<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/adapt_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_top_bar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_top_bar"
        android:elevation="8dp"
        android:paddingHorizontal="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Edit Profile"
            android:textColor="@color/adapt_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/back_button"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/save_button"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Save"
            android:textColor="@color/adapt_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:paddingBottom="32dp">

            <include
                android:id="@+id/name_card"
                layout="@layout/section_edit_text" />

            <include
                android:id="@+id/age_card"
                layout="@layout/section_edit_text" />

            <include
                android:id="@+id/gender_card"
                layout="@layout/section_edit_text" />

            <include
                android:id="@+id/allergies_card"
                layout="@layout/section_edit_multiline" />

            <include
                android:id="@+id/intolerances_card"
                layout="@layout/section_edit_multiline" />

            <include
                android:id="@+id/scenario_card"
                layout="@layout/section_edit_multiline" />

            <include
                android:id="@+id/guidelines_card"
                layout="@layout/section_edit_multiline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Routine reminder enabled"
                    android:textColor="@color/adapt_on_surface"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/reminder_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <include
                android:id="@+id/reminder_minutes_card"
                layout="@layout/section_edit_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_add"
                    android:drawablePadding="8dp"
                    android:text="Add Context for AI Summary"
                    android:textColor="@color/adapt_error"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Upload docs or files for AI to scan and extract a summary"
                    android:textColor="@color/adapt_on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <include
                android:id="@+id/summary_card"
                layout="@layout/section_edit_multiline" />

            <Button
                android:id="@+id/update_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_primary_button"
                android:text="Update Patient File"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Last sync: Just now"
                android:textColor="@color/adapt_on_surface_variant"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/delete_button"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_error_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_delete"
                    android:drawablePadding="8dp"
                    android:text="Delete Patient File"
                    android:textColor="@color/adapt_error"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="This action is permanent and cannot be undone."
                    android:textColor="@color/adapt_error"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
