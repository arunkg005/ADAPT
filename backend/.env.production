# ============================================================
# ADAPT — Production Environment Variables
# Copy this to .env on your production server and fill in values.
# NEVER commit real secrets to version control.
# ============================================================

# ---------- Django Core ----------
DJANGO_SECRET_KEY=CHANGE_ME_use_python_c_import_secrets_secrets_token_urlsafe_64
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=adapt-care.duckdns.org

# ---------- PostgreSQL ----------
POSTGRES_DB=adapt_db
POSTGRES_USER=adapt_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST=db                 # docker-compose service name
POSTGRES_PORT=5432

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Google AI ----------
GEMINI_API_KEY=CHANGE_ME_your_google_ai_key
GEMINI_MODEL=gemini-2.5-flash


# ---------- S3 / Object Storage ----------
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_STORAGE_BUCKET_NAME=adapt-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=                 # Leave blank for AWS S3; set for DigitalOcean Spaces / Cloudflare R2

# ---------- Email (SMTP) ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=ADAPT <noreply@yourdomain.com>
