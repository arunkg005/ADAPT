<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/adapt_surface"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp"
    android:paddingVertical="18dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:orientation="vertical">

        <TextView
            android:id="@+id/task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/adapt_on_surface"
        android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/task_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/adapt_on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/task_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:textColor="@color/adapt_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="188dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/task_priority"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_chip_accent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:textColor="@color/adapt_error"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/task_status"
            android:layout_width="92dp"
            android:layout_height="30dp"
            android:layout_marginStart="16dp"
            android:gravity="center"
            android:textColor="@color/adapt_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
